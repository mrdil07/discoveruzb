# DiscoverUzb backend — environment variables

# ===== App =====
APP_NAME=DiscoverUzb
APP_ENV=development                    # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-random-32-bytes-hex
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://discoveruzb:discoveruzb@localhost:5432/discoveruzb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== JWT =====
JWT_SECRET_KEY=change-me-to-random-32-bytes-hex
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ===== Telegram Gateway =====
# https://gateway.telegram.org/account
TELEGRAM_GATEWAY_TOKEN=<your-gateway-token>
TELEGRAM_OTP_LENGTH=6
TELEGRAM_OTP_TTL_SECONDS=300           # 5 daqiqa
TELEGRAM_OTP_MAX_ATTEMPTS=5

# ===== Google OAuth =====
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID_IOS=<ios-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=<android-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=<web-client-id>.apps.googleusercontent.com

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PUBLIC=media-public
MINIO_BUCKET_PRIVATE=media-private
MINIO_PUBLIC_URL=http://localhost:9000  # Production: https://media.discoveruzb.uz
MINIO_USE_HTTPS=false

# ===== Rate limiting =====
RATE_LIMIT_OTP_PER_MINUTE=1
RATE_LIMIT_OTP_PER_DAY=10
RATE_LIMIT_API_PER_MINUTE=100

# ===== reCAPTCHA v3 (admin panel login) =====
# https://www.google.com/recaptcha/admin
# Dev test kalitlar (har doim success qaytaradi):
#   site:   6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   secret: 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ===== External map reviews (Sprint 9) =====
# Google Places API (New) — https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=
# Yandex Maps Places API — https://developer.tech.yandex.com/services/
YANDEX_MAPS_API_KEY=
# 2GIS Catalog API — https://dev.2gis.ru/
GIS_API_KEY=
# Cache TTL soat'larda
EXTERNAL_REVIEWS_CACHE_HOURS=24
EXTERNAL_REVIEWS_PER_SOURCE_LIMIT=20
